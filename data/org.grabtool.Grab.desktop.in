[Desktop Entry]
Type=Application
Name=Grab
Comment=Capture the entire screen and copy it to the clipboard
Exec="@EXECUTABLE@"
Icon=org.grabtool.Grab
Terminal=false
NoDisplay=true
Categories=Utility;
Keywords=screenshot;screen;capture;clipboard;
StartupNotify=false
DBusActivatable=true
Actions=Preferences;

[Desktop Action Preferences]
Name=Preferences
Exec="@EXECUTABLE@" --preferences
